# Copy to .env and adjust. Never commit .env.

# local | test | production
ENVIRONMENT=local
DEBUG=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (containers, log shippers) | console (human-readable, local dev)
LOG_FORMAT=console

# --- Database -----------------------------------------------------------------------------
# Local Postgres (docker compose `db` service):
DATABASE_URL=postgresql://eve:eve@localhost:5433/eve

# Supabase (Project Settings -> Database -> Connection string). Plain postgresql:// URLs are
# accepted and routed to the psycopg driver automatically.
#   App traffic -> Supavisor transaction pooler (port 6543):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   Migrations  -> session pooler (port 5432) or direct connection:
# MIGRATIONS_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
# Required behind Supavisor transaction mode; harmless elsewhere.
DB_DISABLE_PREPARED_STATEMENTS=true

# --- Auth ---------------------------------------------------------------------------------
# Required, >= 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Bookings & payments ------------------------------------------------------------------
BOOKING_MIN_LEAD_MINUTES=30
BOOKING_MAX_DAYS_AHEAD=60
# Approval probability for the `mock_card_random` test payment method (0..1).
MOCK_PAYMENT_SUCCESS_RATE=0.8
# Shared HMAC secret for provider webhooks, >= 32 chars (the mock provider CLI uses it too).
WEBHOOK_SECRET=change-me-to-a-long-random-webhook-secret-32+
WEBHOOK_TOLERANCE_SECONDS=300
